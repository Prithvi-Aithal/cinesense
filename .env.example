# The web app connects as cinesense_app, a restricted login role that `npm run seed` creates.
# It has no privileges of its own: each request switches to the anon, viewer or admin role.
DATABASE_URL=postgres://cinesense_app:cinesense_app@localhost:5432/moviedb
# The seed script creates tables, functions, triggers and roles, so it connects as the database owner.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/moviedb
# Optional: load the embedding model from a local folder instead of downloading it.
# MODEL_DIR=/path/to/models
